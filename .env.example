# Copy to .env and fill in. `.env` is gitignored.

# ─── Dashboard accounts ──────────────────────────────────
# On first start with no accounts, this creates the first Owner (username
# `admin` unless PANEL_ADMIN_USER says otherwise). After that it is ignored —
# manage people from the Users tab. Must meet MIN_PASSWORD_LENGTH.
PANEL_PASSWORD=change-me-to-something-long
# PANEL_ADMIN_USER=admin

# Sessions are server-side and revocable; there is no signing key to configure.
# SESSION_TTL_HOURS=12
# MIN_PASSWORD_LENGTH=10

# How long the audit log keeps entries.
# AUDIT_RETENTION_DAYS=180

# Backup retention. Backups thin out rather than truncate.
# BACKUP_KEEP_LATEST=5
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# BACKUP_MAX_TOTAL=50
# Rollback points taken before an edit are never pruned this fresh.
# BACKUP_SAFETY_GRACE_HOURS=48

# Read-only guest view: map, server status, base locations.
GUEST_VIEW_ENABLED=true

# Leave unset to infer from the request (X-Forwarded-Proto or the URL scheme),
# which is right for both plain-http LAN and a TLS reverse proxy. Force it only
# if your proxy does not set the header.
# COOKIE_SECURE=true

# ─── Palworld server ─────────────────────────────────────
# Must match AdminPassword in PalWorldSettings.ini, and the server needs
# RESTAPIEnabled=True.
PALWORLD_ADMIN_PASSWORD=your-admin-password

# With the bundled compose file this is the service name on the private
# network. Do not publish port 8212 to the internet.
PALWORLD_REST_URL=http://palworld:8212

SERVER_NAME=My Palworld Server

# ─── Paths inside the container ──────────────────────────
SAVE_BASE_DIR=/palworld/Pal/Saved/SaveGames/0
# Kept off the server directory so mounting /palworld read-only still allows
# backups.
BACKUP_DIR=/app/backups
CACHE_DIR=/app/cache
# Auto-detected from SAVE_BASE_DIR; set only if your layout is unusual.
# PALWORLD_CONFIG_INI=/palworld/Pal/Saved/Config/LinuxServer/PalWorldSettings.ini
# Pin a world if you have more than one; otherwise the most recently written wins.
# WORLD_GUID=

# ─── Corruption safety ───────────────────────────────────
# Hard lock: never write to save files, even when the server is provably down.
SAVE_READ_ONLY=false

# A .sav written within this many seconds means the server is alive.
SAVE_ACTIVITY_WINDOW_SECONDS=300

# Leave false. True lets an INCONCLUSIVE server-state check count as "stopped",
# which is exactly how a live world gets corrupted.
ALLOW_UNVERIFIED_EDITS=false

# ─── Performance ─────────────────────────────────────────
# Level.sav parsing. Turn off and the live REST features still work fully.
PARSE_ENABLED=true

# false (default) = nothing parses on its own; the save is read ONLY when you
# press Refresh. Reads serve cached data and never trigger work. Set true to
# also let stale data refresh itself in the background.
PARSE_AUTO=false

# Minimum seconds between automatic parses. Only applies when PARSE_AUTO=true;
# manual Refresh always parses immediately.
PARSE_MIN_INTERVAL_SECONDS=900

# Give up on a parse after this long.
PARSE_TIMEOUT_SECONDS=600

# Decode chest/inventory contents. Measured at ~2% extra cost, so leave on
# unless you are very tight on memory.
PARSE_INCLUDE_ITEMS=true

# Refuse to parse a Level.sav larger than this (MB). Peak memory runs roughly
# 8x the *decompressed* size.
PARSE_MAX_SIZE_MB=1024

# Defer a parse when the game server is already struggling. Gameplay wins over
# dashboard responsiveness.
#
# This gates the START of a parse and never interrupts one in flight — a running
# parse has already paid most of its cost and is niced, so killing it wastes the
# work and frees capacity only until the next request begins again.
#
# It fails OPEN, unlike the save-write guard: no metrics, a stale sample or an
# unreachable server all read as "fine to parse". Only a live reading below the
# floor defers anything.
PARSE_LOAD_AWARE=true
# Automatic parses stop below this server FPS. Palworld targets 30; players report
# lag in the sustained-under-20 range.
PARSE_MIN_SERVER_FPS=20
# A manual Refresh gets more latitude — the operator asked and is watching, so
# overriding them needs the server to be in real trouble rather than merely busy.
PARSE_FORCE_MIN_SERVER_FPS=12

# ─── Metrics history (Phase 8) ───────────────────────────
# Samples server FPS, players, CPU, memory, disk and world size into SQLite.
# Rows are kept raw with no rollup: at 60s that is ~43,000 rows for 30 days,
# which SQLite answers instantly.
#
# A sample is written even when the game is unreachable, so an outage draws as a
# gap rather than being interpolated over.
METRICS_ENABLED=true
METRICS_INTERVAL_SECONDS=60
METRICS_RETENTION_DAYS=30

# How long to wait on the game's REST API for a command (kick/ban/announce/save).
GAME_API_TIMEOUT_SECONDS=10

# Where the game keeps its ban list. Auto-detected beside PalWorldSettings.ini;
# set this only if yours lives elsewhere. Read-only — the dashboard never writes
# it, and never mirrors it into its own database.
# PALWORLD_BANLIST=/palworld/Pal/Saved/Config/LinuxServer/banlist.txt

# ─── Restarting the game server (optional) ───────────────
# The REST API can stop the server but never start it. Leave unset if your
# server container exits when PalServer exits (its restart policy handles it).
# Set it if your container keeps running with the game process dead.
# Prefer a docker-socket-proxy over mounting the raw socket — see README.
#
# NOTE the `docker` CLI is deliberately NOT installed in the runtime image, so a
# command starting with `docker` fails with "not found". Use `node`, which is in
# the image and has a global fetch; docs/DEPLOYMENT.md §4 has the exact commands
# for stop/start/restart and explains why 304 counts as success.
#
# Also worth knowing before enabling any of this: ANY access to a Docker socket is
# host-root-capable, including through a proxy. Announce-and-shutdown already works
# with no Docker at all, and save editing unlocks by itself once the server is
# provably down — so the only thing this buys is a "start it again" button.
# RESTART_COMMAND=node -e "fetch('http://docker-proxy:2375/containers/palworld-server/restart',{method:'POST'}).then(r=>process.exit(r.status<300||r.status===304?0:1)).catch(()=>process.exit(1))"
RESTART_COMMAND=

# Stops the whole container, not just the game process. This is the clean way to
# prepare for save edits — a stopped container cannot relaunch the server
# underneath an in-progress write.
# STOP_COMMAND=docker -H tcp://docker-proxy:2375 stop palworld-server
STOP_COMMAND=

# Brings it back after maintenance, completing the stop -> edit -> start cycle
# from the dashboard. Without it, run `docker compose start palworld` yourself.
# START_COMMAND=docker -H tcp://docker-proxy:2375 start palworld-server
START_COMMAND=

# How long to watch for the server to come back after a shutdown.
SERVER_RETURN_WATCH_SECONDS=180

# ─── Internal ────────────────────────────────────────────
PYTHON_BACKEND_URL=http://127.0.0.1:8400
BACKEND_PORT=8400
BACKEND_HOST=127.0.0.1
