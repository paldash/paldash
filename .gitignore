# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ─── Palworld server data ────────────────────────────────
# NEVER commit save files. They contain real Steam IDs, player names and
# in-game positions, and Level.sav can be hundreds of megabytes.
/palworld/
/refworld/
/backups/
*.sav
*.sav.bak

# Local copies of PalWorldSettings.ini contain your admin/RCON passwords.
PalWorldSettings.ini

# Parse cache produced by the save backend
/cache/
level_cache.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Artifacts
*.md
!README.md
*.txt
!requirements.txt

